# Generated/local files that must never be committed.

# Terraform
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.*
terraform/*.tfplan

# Ansible generated artifact (rendered fresh by scripts/configure.sh on
# every run — never edit or commit it directly)
ansible/inventory/inventory.ini
*.retry

# CI job artifacts
vm_ipv4_address.txt
